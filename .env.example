# Example environment configuration.
#
# PLACEHOLDER VALUES ONLY - never commit real keys to this file.
# Set the real values in the Render dashboard (Environment -> Environment Variables).

# --- Required ---------------------------------------------------------------

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Pl@ntNet: https://my.plantnet.org/
PLANTNET_API_KEY=your-plantnet-api-key-here

# Supabase project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SERVICE ROLE key (Settings -> API). This is a full-access admin
# credential: it belongs only in Render's environment, never in frontend code
# and never in this repository.
SUPABASE_KEY=your-supabase-service-role-key-here

# Frontend origin(s) allowed to call this API. Comma-separated so you can
# include a Vercel preview URL alongside production. No trailing slash.
ALLOWED_ORIGIN=https://your-app.vercel.app

# --- Optional overrides (sensible defaults are built in) --------------------

# Pinned Flash-Lite model: highest free-tier throughput of the vision-capable
# Flash family. Switch to gemini-flash-latest if your key lacks access.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Pl@ntNet project. "all" is worldwide flora.
# PLANTNET_PROJECT=all

# Below this score we distrust Pl@ntNet and fall through to Gemini.
# PLANTNET_MIN_SCORE=0.15

# Upstream HTTP timeout, seconds.
# HTTP_TIMEOUT_SECONDS=25

# Max upload size in bytes (default 10 MB).
# MAX_UPLOAD_BYTES=10485760

# --- Rate limiting ----------------------------------------------------------
# Per-IP limits applied to every API route. Raise these from the Render
# dashboard if legitimate users get throttled - no redeploy needed.
# RATE_LIMIT_PER_MIN=5
# RATE_LIMIT_PER_DAY=20

# Global ceiling across all callers. This is what actually protects the
# Pl@ntNet and Gemini free quotas from distributed traffic.
# GLOBAL_IDENTIFY_PER_DAY=300
